{
  "name": "cap-web-demo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "tsx watch app/backend/src/server.ts",
    "dev:frontend": "vite --config app/frontend/vite.config.ts",
    "build": "tsc -p app/backend/tsconfig.json && vue-tsc -p app/frontend/tsconfig.json && vite build --config app/frontend/vite.config.ts",
    "test": "tsx --test app/backend/src/*.test.ts",
    "test:load": "node --import tsx scripts/load-test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "vue": "^3.5.18",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "concurrently": "^9.2.1",
    "n8n-nodes-message-sync-ai": "0.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.1.0"
  }
}
